{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "start",
        "--",
        "--no-open",
        "--port",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "site-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "site",
        "run",
        "serve",
        "--",
        "--no-open",
        "--port",
        "3001"
      ],
      "port": 3001
    }
  ]
}
